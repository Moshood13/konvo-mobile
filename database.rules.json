{
	"rules": {
		".read": false,
		".write": false,

		"status": {
			"$uid": {
				".read": "auth != null",
				".write": "auth != null && auth.uid == $uid",
				".validate": "newData.hasChildren(['state', 'lastChangedAt'])",
				"state": {
					".validate": "newData.isString() && (newData.val() == 'online' || newData.val() == 'offline')"
				},
				"lastChangedAt": { ".validate": "newData.isNumber()" },
				"activeConversation": { ".validate": "newData.isString() || newData.val() == null" },
				"$other": { ".validate": false }
			}
		},

		"members": {
			"$cid": {
				".read": "auth != null && data.child(auth.uid).exists()",
				"$uid": {
					".write": false
				}
			}
		},

		"typing": {
			"$cid": {
				".read": "auth != null && root.child('members').child($cid).child(auth.uid).exists()",
				"$uid": {
					".write": "auth != null && auth.uid == $uid && root.child('members').child($cid).child(auth.uid).exists()",
					".validate": "newData.isNumber() || newData.val() == null"
				}
			}
		}
	}
}
