{
	"cli": {
		"version": ">= 14.2.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"APP_ENV": "development"
			}
		},
		"preview": {
			"distribution": "internal",
			"environment": "preview",
			"env": {
				"APP_ENV": "staging"
			}
		},
		"production": {
			"autoIncrement": true,
			"environment": "production",
			"env": {
				"APP_ENV": "production"
			}
		}
	}
}
