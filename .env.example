# Firebase Web app config (from Firebase Console > Project settings > Your apps > Web app)
# These values are safe to expose on the client; they identify the project, not authorize access.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google OAuth client IDs (Google Cloud Console > APIs & Services > Credentials)
# Used by expo-auth-session for Google sign-in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
