# --- Firebase (free Spark plan) -------------------------------------------------
# Firebase Console > Project settings > Your apps > Web app.
# These values are safe to expose on the client; they identify the project, not
# authorize access. Access is controlled entirely by firestore.rules.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Realtime Database URL (Firebase Console > Realtime Database > the URL at the top).
# Looks like https://<project-id>-default-rtdb.<region>.firebasedatabase.app
# Carries presence and typing indicators — Firestore has no onDisconnect primitive.
FIREBASE_DATABASE_URL=

# --- Google sign-in ---------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials. Used by expo-auth-session.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Cloudinary (free tier, no card) ----------------------------------------------
# Profile photos and image messages. Firebase Storage needs the paid Blaze plan on
# projects created after Oct 2024, so we use Cloudinary's free 25 GB instead.
#
# Setup: cloudinary.com > Settings > Upload > Add upload preset >
#        Signing mode: Unsigned. Then restrict it:
#          - allowed formats: jpg,png,webp
#          - max file size: 10 MB
#          - folder: konvo
#        Those restrictions matter, because an unsigned preset ships in the app
#        and anyone who extracts it can upload to your account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# --- Optional ---------------------------------------------------------------------
# Sentry DSN (Sentry > Project Settings > Client Keys). Leave blank and Sentry
# stays disabled rather than erroring.
SENTRY_DSN=

# Local development against the Firebase emulator suite. Set to 1 and run
# `firebase emulators:start` (needs Java installed). On an Android emulator also set
# EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2 — localhost there is the emulator itself.
EXPO_PUBLIC_USE_EMULATORS=0
EXPO_PUBLIC_EMULATOR_HOST=localhost
